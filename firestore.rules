rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return hasProfile() && currentUser().role in ['superadmin', 'admin'];
    }

    function isOwner() {
      return hasProfile() && currentUser().role == 'owner';
    }

    function isManager() {
      return hasProfile() && currentUser().role == 'manager';
    }

    function canManageBranch(branchId) {
      return isSuperadmin()
        || ((isOwner() || isManager())
          && branchId in currentUser().assignedBranches);
    }

    match /users/{userId} {
      allow read: if hasProfile() && (
        request.auth.uid == userId
        || isSuperadmin()
        || (isOwner() && resource.data.businessId == currentUser().businessId)
      );

      // Accounts and privileged role fields are provisioned by the trusted
      // backend/Admin SDK. Owners may only maintain staff in their business.
      allow create: if false;
      allow update: if isSuperadmin() || (
        isOwner()
        && resource.data.businessId == currentUser().businessId
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.role == resource.data.role
        && resource.data.role in ['staff', 'manager']
      );
      allow delete: if isSuperadmin() || (
        isOwner()
        && resource.data.businessId == currentUser().businessId
        && resource.data.role in ['staff', 'manager']
      );
    }

    match /businesses/{businessId} {
      allow read: if isSuperadmin()
        || (isOwner() && currentUser().businessId == businessId);
      allow write: if isSuperadmin()
        || (isOwner() && currentUser().businessId == businessId);
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if canManageBranch(branchId);
    }

    match /branches/{branchId}/staff/{staffId} {
      allow read: if true;
      allow write: if canManageBranch(branchId);

      match /workingHours/{dayId} {
        allow read: if true;
        allow write: if canManageBranch(branchId);
      }

      match /absences/{absenceId} {
        allow read: if true;
        allow write: if canManageBranch(branchId);
      }
    }

    match /branches/{branchId}/services/{serviceId} {
      allow read: if true;
      allow write: if canManageBranch(branchId);
    }

    match /branches/{branchId}/categories/{categoryId} {
      allow read: if true;
      allow write: if canManageBranch(branchId);
    }

    match /invitations/{code} {
      allow read: if signedIn();
      allow write: if isSuperadmin() || isOwner();
    }

    match /branches/{branchId}/bookings/{bookingId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if canManageBranch(branchId);
    }

    match /branches/{branchId}/auditLogs/{logId} {
      allow read, write: if canManageBranch(branchId);
    }

    match /branches/{branchId}/analytics/{analyticsId} {
      allow read, write: if isSuperadmin() || (
        isOwner() && branchId in currentUser().assignedBranches
      );
    }

    match /branches/{branchId}/analytics_basic/{analyticsId} {
      allow read, write: if canManageBranch(branchId);
    }

    match /{path=**}/bookings/{bookingId} {
      allow read: if isSuperadmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
