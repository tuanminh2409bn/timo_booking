    {
      "name": "11 Weekly Report",
      "item": [
        {
          "name": "Generate Weekly Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 or documented error\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 400, 401, 403, 404, 409, 429]); });",
                  "function expectErrorShape(json) {",
                  "  pm.expect(json).to.have.property(\"type\").that.is.a(\"string\");",
                  "  pm.expect(json).to.have.property(\"message\").that.is.a(\"string\");",
                  "}",
                  "function expectWeeklyReportItem(item) {",
                  "  pm.expect(item).to.include.keys([\"id\", \"shopId\", \"branchId\", \"weekStartDate\", \"weekEndDate\", \"summary\", \"dailyMetrics\", \"employeeBreakdowns\", \"serviceBreakdowns\", \"revision\"]);",
                  "  pm.expect(item.summary).to.include.keys([\"totalAttendances\", \"totalRevenue\", \"totalDiscount\", \"totalNetRevenue\", \"totalOwnerCommission\", \"totalEmployeeEarnings\", \"averageTicketSize\", \"workingDays\"]);",
                  "  pm.expect(item.dailyMetrics).to.be.an(\"array\");",
                  "  pm.expect(item.employeeBreakdowns).to.be.an(\"array\");",
                  "  pm.expect(item.serviceBreakdowns).to.be.an(\"array\");",
                  "}",
                  "function persistWeeklyReportVars(item) {",
                  "  if (!item) return;",
                  "  if (item.id) pm.environment.set(\"weeklyReportId\", item.id);",
                  "  if (item.branchId) pm.environment.set(\"weeklyReportBranchId\", item.branchId);",
                  "  if (item.weekStartDate) pm.environment.set(\"weeklyReportWeekStartDate\", item.weekStartDate);",
                  "}",
                  "if (![204, 304].includes(pm.response.code)) {",
                  "  const json = pm.response.json();",
                  "  pm.test(\"response shape\", function () {",
                  "    if (pm.response.code >= 400) {",
                  "      expectErrorShape(json);",
                  "    } else {",
                  "      pm.expect(json).to.have.property(\"item\").that.is.an(\"object\");",
                  "      expectWeeklyReportItem(json.item);",
                  "      pm.expect(json).to.have.property(\"meta\").that.is.an(\"object\");",
                  "    }",
                  "  });",
                  "  if (pm.response.code < 400) persistWeeklyReportVars(json.item);",
                  "}",
                  "if ([200, 201, 304].includes(pm.response.code)) {",
                  "  pm.test(\"has ETag\", function () { pm.expect(pm.response.headers.get(\"ETag\")).to.exist; });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{ownerJwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"weekStartDate\": \"{{weeklyReportWeekStartDate}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/weekly-report"
          }
        },
        {
          "name": "List Weekly Reports",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 or documented error\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 304, 400, 401, 403, 404, 429]); });",
                  "function expectErrorShape(json) {",
                  "  pm.expect(json).to.have.property(\"type\").that.is.a(\"string\");",
                  "  pm.expect(json).to.have.property(\"message\").that.is.a(\"string\");",
                  "}",
                  "function expectWeeklyReportItem(item) {",
                  "  pm.expect(item).to.include.keys([\"id\", \"shopId\", \"branchId\", \"weekStartDate\", \"weekEndDate\", \"summary\", \"dailyMetrics\", \"employeeBreakdowns\", \"serviceBreakdowns\", \"revision\"]);",
                  "  pm.expect(item.summary).to.include.keys([\"totalAttendances\", \"totalRevenue\", \"totalDiscount\", \"totalNetRevenue\", \"totalOwnerCommission\", \"totalEmployeeEarnings\", \"averageTicketSize\", \"workingDays\"]);",
                  "  pm.expect(item.dailyMetrics).to.be.an(\"array\");",
                  "  pm.expect(item.employeeBreakdowns).to.be.an(\"array\");",
                  "  pm.expect(item.serviceBreakdowns).to.be.an(\"array\");",
                  "}",
                  "function persistWeeklyReportVars(item) {",
                  "  if (!item) return;",
                  "  if (item.id) pm.environment.set(\"weeklyReportId\", item.id);",
                  "  if (item.branchId) pm.environment.set(\"weeklyReportBranchId\", item.branchId);",
                  "  if (item.weekStartDate) pm.environment.set(\"weeklyReportWeekStartDate\", item.weekStartDate);",
                  "}",
                  "if (![204, 304].includes(pm.response.code)) {",
                  "  const json = pm.response.json();",
                  "  pm.test(\"response shape\", function () {",
                  "    if (pm.response.code >= 400) {",
                  "      expectErrorShape(json);",
                  "    } else {",
                  "      pm.expect(json).to.have.property(\"items\").that.is.an(\"array\");",
                  "      pm.expect(json).to.have.property(\"meta\").that.includes.keys([\"shopId\", \"branchId\", \"fromWeek\", \"toWeek\", \"totalCount\", \"missingWeeks\", \"expectedWeeks\"]);",
                  "      if (json.items.length > 0) expectWeeklyReportItem(json.items[0]);",
                  "      if (json.aggregate) pm.expect(json.aggregate).to.include.keys([\"totalAttendances\", \"totalRevenue\", \"totalDiscount\", \"totalNetRevenue\", \"totalOwnerCommission\", \"totalEmployeeEarnings\", \"averageTicketSize\", \"workingDays\"]);",
                  "    }",
                  "  });",
                  "  if (pm.response.code < 400) persistWeeklyReportVars(json.items && json.items[0]);",
                  "}",
                  "if ([200, 304].includes(pm.response.code)) {",
                  "  pm.test(\"has ETag\", function () { pm.expect(pm.response.headers.get(\"ETag\")).to.exist; });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{ownerJwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/weekly-report?branchId={{branchId}}&fromWeek={{weeklyReportWeekStartDate}}&toWeek={{weeklyReportWeekStartDate}}&aggregate=true"
          }
        },
