{
  "name": "nailsalonmanagementsystem-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig-build.json",
    "start": "node dist/index.js",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:integration": "node node_modules/vitest/vitest.mjs run --coverage",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write .",
    "retention:run": "node node_modules/tsx/dist/cli.mjs src/jobs/data-retention.ts",
    "audit:firestore-read-path": "node scripts/audit-firestore-read-path.mjs",
    "seed:employee-work-day-closings": "node scripts/seed-employee-work-day-closings.mjs",
    "redis:up": "docker compose -f docker-compose.redis.yml up -d",
    "redis:down": "docker compose -f docker-compose.redis.yml down",
    "redis:logs": "docker compose -f docker-compose.redis.yml logs -f redis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daeyang-Sea/NailSalonManagementSystem-Backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Daeyang-Sea/NailSalonManagementSystem-Backend/issues"
  },
  "homepage": "https://github.com/Daeyang-Sea/NailSalonManagementSystem-Backend#readme",
  "dependencies": {
    "@google-cloud/firestore": "^8.3.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "redis": "^5.12.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.5"
  }
}
